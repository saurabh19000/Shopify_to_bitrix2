# PostgreSQL (required — used for OAuth token + Shopify<->Bitrix ID mapping)
# Local (no SSL auto-detected on localhost/127.0.0.1):
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/shopify_bitrix
# External/cloud (add ?sslmode=require for Render/Neon, etc.):
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

PORT=3001

# Shopify App credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=shpat_xxx_from_your_custom_app
# Public HTTPS URL of this server (Render gives you https://<app>.onrender.com). Shopify calls this for webhooks + OAuth.
SHOPIFY_APP_URL=https://your-app.onrender.com
SHOPIFY_SCOPES=read_customers,read_products,read_orders,read_fulfillments,read_inventory,read_checkouts
SHOPIFY_API_VERSION=2024-10
SHOPIFY_STORE_URL=yourstore.myshopify.com

# Bitrix24 CRM Webhook URL (Settings -> Integrations -> Webhooks -> Incoming webhook)
BITRIX_WEBHOOK_URL=https://your-bitrix24.bitrix24.in/rest/1/your_webhook_secret/

# Bitrix24 Inventory & CRM Settings
BITRIX_WAREHOUSE_ID=2
BITRIX_RESPONSIBLE_ID=1
BITRIX_CURRENCY=INR
BITRIX_STORE_DOMAIN=yourstore.myshopify.com

# Customer lifetime metrics (Total Orders, Total Spend, AOV, Last Purchase) — true/false
COMPUTE_LIFETIME=true

# Lead (abandoned cart / checkout) settings
BITRIX_LEAD_RESPONSIBLE_ID=1
BITRIX_ABANDONED_CART_STAGE=NEW
BITRIX_CHECKOUT_STAGE=NEW

# Invoice sync — create a Bitrix invoice per Shopify order + attach PDF
BITRIX_INVOICE_SYNC_ENABLED=true
BITRIX_INVOICE_PAY_SYSTEM_ID=1
BITRIX_INVOICE_STATUS_ID=1

# Two-way sync (Bitrix -> Shopify). Use this token in the Bitrix outgoing webhook URL:
#   {SHOPIFY_APP_URL}/sync/bitrix/contact-update?token=<BITRIX_SYNC_TOKEN>
BITRIX_SYNC_TOKEN=your_shared_secret_for_two_way_sync

# Debug logging — prints detailed [DEBUG] traces for every sync operation
# (webhook receipts, Bitrix/Shopify API calls, ID map lookups, decisions).
DEBUG=true
